---
import Logo from "./Logo.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
	{ href: "/", label: "Home" },
	{ href: "/ports", label: "Ports" },
	{ href: "/palette", label: "Palette" },
	{ href: "/contribute", label: "Contribute" },
];
---

<header class="nav">
	<div class="wrap inner">
		<a href="/" class="mark">
			<Logo size={27} class="glyph" />
			<span class="name">DARKMATTER</span>
		</a>

		<button
			class="toggle"
			type="button"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="nav-links"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>

		<nav class="links" id="nav-links">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={["link", { active: link.href === path }]}
					>
						{link.label}
					</a>
				))
			}
			<a
				href="https://github.com/darkmattertheme"
				class="link gh"
				rel="noreferrer"
				target="_blank"
			>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
					></path>
				</svg>
				<span class="gh-label">GitHub</span>
			</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".nav");
	const toggle = header?.querySelector<HTMLButtonElement>(".toggle");

	const setOpen = (open: boolean) => {
		header?.classList.toggle("open", open);
		toggle?.setAttribute("aria-expanded", String(open));
	};

	toggle?.addEventListener("click", () => {
		setOpen(!header?.classList.contains("open"));
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});

	document.addEventListener("click", (e) => {
		if (header && !header.contains(e.target as Node)) setOpen(false);
	});
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(12px);
		background: rgba(18, 17, 19, 0.72);
		border-bottom: 1px solid var(--border);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}

	.mark {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		font-size: 16px;
		letter-spacing: 0.18em;
		color: var(--text-bright);
	}

	.mark:hover {
		color: var(--text-bright);
	}

	.mark :global(.glyph) {
		flex: none;
		filter: drop-shadow(0 0 7px rgba(231, 138, 83, 0.35));
		transition: filter 0.2s ease;
	}

	.mark:hover :global(.glyph) {
		filter: drop-shadow(0 0 11px rgba(231, 138, 83, 0.6));
	}

	.links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.link {
		padding: 6px 11px;
		border-radius: 7px;
		font-size: 13px;
		color: var(--text-dim);
		transition: color 0.15s ease, background 0.15s ease;
	}

	.link:hover {
		color: var(--text-bright);
		background: var(--surface);
	}

	.link.active {
		color: var(--text-bright);
	}

	.gh {
		display: inline-flex;
		align-items: center;
		padding: 7px;
	}

	.gh-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0 10px;
		margin-right: -10px;
		background: none;
		border: 0;
		border-radius: 7px;
		cursor: pointer;
	}

	.toggle:hover {
		background: var(--surface);
	}

	.bar {
		display: block;
		height: 1.5px;
		width: 100%;
		background: var(--text-bright);
		border-radius: 1px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav.open .bar:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}

	.nav.open .bar:nth-child(2) {
		opacity: 0;
	}

	.nav.open .bar:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	@media (max-width: 640px) {
		.toggle {
			display: inline-flex;
		}

		.links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 2px;
			padding: 8px 12px 16px;
			background: rgba(18, 17, 19, 0.96);
			border-bottom: 1px solid var(--border);
		}

		.nav.open .links {
			display: flex;
		}

		.link {
			padding: 12px;
			font-size: 15px;
		}

		.gh {
			gap: 10px;
			padding: 12px;
		}

		.gh-label {
			position: static;
			width: auto;
			height: auto;
			overflow: visible;
			clip-path: none;
		}
	}

	@media (max-width: 380px) {
		.mark .name {
			font-size: 13px;
		}
	}
</style>
