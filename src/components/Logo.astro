---
interface Props {
	/** Rendered size in px (the mark is square) */
	size?: number;
	/** Send the small moon around its orbit */
	animate?: boolean;
	class?: string;
}

const { size = 24, animate = false, class: className } = Astro.props;
---

<svg
	viewBox="0 0 512 512"
	width={size}
	height={size}
	fill="none"
	role="img"
	aria-label="Darkmatter"
	class:list={["logo", { animate }, className]}
>
	<title>Darkmatter</title>
	<path
		d="M256 336C300.183 336 336 300.183 336 256C336 211.817 300.183 176 256 176C211.817 176 176 211.817 176 256C176 300.183 211.817 336 256 336Z"
		stroke="#E78A53"
		stroke-width="25.6"></path>
	<path
		opacity="0.6"
		d="M256 416C344.366 416 416 344.366 416 256C416 167.634 344.366 96 256 96C167.634 96 96 167.634 96 256C96 344.366 167.634 416 256 416Z"
		stroke="#5F8787"
		stroke-width="16"></path>
	<g class="moon">
		<path
			d="M415.6 281.2C429.738 281.2 441.2 269.738 441.2 255.6C441.2 241.462 429.738 230 415.6 230C401.462 230 390 241.462 390 255.6C390 269.738 401.462 281.2 415.6 281.2Z"
			fill="#FBCB97"></path>
	</g>
</svg>

<style>
	.logo {
		overflow: visible;
	}

	.moon {
		transform-box: view-box;
		transform-origin: 256px 256px;
	}

	.logo.animate .moon {
		animation: orbit 28s linear infinite;
	}

	@keyframes orbit {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo.animate .moon {
			animation: none;
		}
	}
</style>
