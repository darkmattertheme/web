---
import Layout from "../layouts/Layout.astro";
import CodePreview from "../components/CodePreview.astro";
import Palette from "../components/Palette.astro";
import PortCard from "../components/PortCard.astro";
import { ansi } from "../data/palette";
import { ports } from "../data/ports";

const featured = ports.slice(0, 6);
---

<Layout>
	<section class="hero">
		<div class="wrap hero-inner">
			<h1 class="title">DARKMATTER</h1>

			<p class="tagline">
      A dark theme for the open web, and beyond
			</p>

			<div class="actions">
				<a class="btn btn--primary" href="/ports">Browse the ports</a>
				<a
					class="btn btn--ghost"
					href="https://github.com/darkmattertheme/darkmatter"
					target="_blank"
					rel="noreferrer">Source</a
				>
			</div>

			<div class="preview">
				<CodePreview />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap split">
			<div class="copy">
				<h2 class="h2">A classic reborn</h2>
				<p class="lead">
        Darkmatter is based on the original <a href="https://github.com/metalelf0/base16-black-metal-scheme" target="_blank" rel="noreferrer">Black Metal Bathory</a> colorscheme with a slightly different twist on the primary background, providing a sublte yet warm experience.
				</p>
				<div class="ansi">
					{
						ansi.map((hex, i) => (
							<span
								class="ansi-chip"
								style={`background:${hex}`}
								title={`${i} — ${hex}`}
							/>
						))
					}
				</div>
			</div>

			<div class="term">
				<div class="term-bar">
					<span></span><span></span><span></span>
				</div>
				<pre class="term-body"><code><span class="p-dir">~/dev/darkmatter</span> <span class="p-git">on main</span>
<span class="p-arrow">❯</span> eza --icons=always
<span class="c-dir">src</span>  <span class="c-dir">public</span>  <span class="c-file">astro.config.mjs</span>  <span class="c-file">package.json</span>

<span class="p-dir">~/dev/darkmatter</span> <span class="p-git">on main</span>
<span class="p-arrow">❯</span> bun run build
<span class="c-ok">✓</span> 4 page(s) built in <span class="c-num">412ms</span>
<span class="p-arrow">❯</span> <span class="cursor">█</span></code></pre>
			</div>
		</div>
	</section>

	<!-- ───────────── palette ───────────── -->
	<section class="section" id="palette">
		<div class="wrap">
			<div class="row">
				<div>
					<h2 class="h2">Base16 simplicity</h2>
					<p class="lead">
						Click any swatch to copy it. These sixteen values are all you need
						to build a port of your own.
					</p>
				</div>
				<a class="btn" href="/palette">ANSI + scheme</a>
			</div>

			<div class="pad">
				<Palette />
			</div>
		</div>
	</section>

	<!-- ───────────── ports ───────────── -->
	<section class="section">
		<div class="wrap">
			<div class="row">
				<div>
					<h2 class="h2">Take it with you</h2>
				</div>
				<a class="btn" href="/ports">All {ports.length} ports</a>
			</div>

			<div class="ports pad">
				{featured.map((port) => <PortCard port={port} />)}
			</div>
		</div>
	</section>
</Layout>

<style>
	/* hero */
	.hero {
		padding-top: clamp(56px, 11vw, 120px);
		padding-bottom: clamp(32px, 6vw, 56px);
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.title {
		font-size: clamp(2.6rem, 11vw, 5.5rem);
		letter-spacing: 0.06em;
		color: #ffffff;
	}

	.tagline {
		margin-top: 20px;
		max-width: 46ch;
		color: var(--text-dim);
		font-size: clamp(0.9rem, 2.4vw, 1.05rem);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin-top: 30px;
	}

	.preview {
		align-self: stretch;
		width: 100%;
		text-align: left;
		margin-top: clamp(44px, 8vw, 72px);
	}

	/* shared */
	.h2 {
		font-size: clamp(1.4rem, 4vw, 1.9rem);
		margin-bottom: 12px;
	}

	.pad {
		margin-top: 26px;
	}

	.row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		flex-wrap: wrap;
	}

	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(28px, 5vw, 56px);
		align-items: center;
	}

	/* ansi strip */
	.ansi {
		display: grid;
		grid-template-columns: repeat(8, 30px);
		gap: 5px;
		margin-top: 26px;
	}

	.ansi-chip {
		width: 30px;
		height: 30px;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.07);
	}

	/* terminal */
	.term {
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--base00);
		overflow: hidden;
		box-shadow: 0 30px 70px -34px rgba(0, 0, 0, 0.95);
	}

	.term-bar {
		display: flex;
		gap: 7px;
		padding: 10px 14px;
		background: var(--base01);
		border-bottom: 1px solid var(--border);
	}

	.term-bar span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--base03);
	}

	.term-body {
		margin: 0;
		padding: 16px;
		font-size: 12.5px;
		line-height: 1.75;
		overflow-x: auto;
		color: var(--base05);
	}

	.term-body code {
		font-family: var(--mono);
	}

	.p-dir {
		color: var(--base0A);
	}
	.p-git {
		color: var(--base08);
	}
	.p-arrow {
		color: var(--base0B);
	}
	.c-dir {
		color: var(--base08);
	}
	.c-file {
		color: var(--base05);
	}
	.c-ok {
		color: var(--base0B);
	}
	.c-num {
		color: var(--base09);
	}

	.cursor {
		color: var(--base0A);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* ports grid */
	.ports {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 14px;
	}

	/* cta */
	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 6px;
		padding: clamp(32px, 6vw, 56px) 24px;
		border: 1px solid var(--border);
		border-radius: 16px;
		background:
			radial-gradient(
				70% 120% at 50% 0%,
				rgba(231, 138, 83, 0.08),
				transparent 70%
			),
			var(--surface);
	}

	.cmd {
		margin-top: 22px;
		max-width: 100%;
		padding: 12px 18px;
		border: 1px solid var(--border-bright);
		border-radius: 10px;
		background: var(--base00);
		color: var(--base0B);
		font-size: 12.5px;
		overflow-x: auto;
	}

	.cmd code {
		font-family: var(--mono);
		white-space: nowrap;
	}

	@media (max-width: 820px) {
		.split {
			grid-template-columns: 1fr;
		}
	}
</style>
